<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="assets_frontend" inherit_id="web.assets_frontend" name="Nextconect Assets Frontened">
        <xpath expr="script[last()]" position="after">
            <script type="text/javascript" src="/website_nexconect/static/src/js/variant_mixin.js"></script>
            <link href="/website_nexconect/static/src/scss/style.scss"
                rel="stylesheet" type="text/scss" />
        </xpath>
    </template>

    <template id="assets_backend" inherit_id="web.assets_backend" name="Nextconect assets backend">
        <xpath expr="script[last()]" position="after">
            <script type="text/javascript" src="/website_nexconect/static/src/js/product_variant_mixin.js"></script>
            <script type="text/javascript" src="/website_nexconect/static/src/js/list_renderer.js"></script>
        </xpath>
    </template>
</odoo>