                <t t-set="_link_class" t-value="'nav-link'"/>
                <t t-set="_dropdown_menu_class" t-value="''"/>
            </t>
        </xpath>
    </template>

    <template id="template_header_sidebar" inherit_id="website.template_header_sidebar">
