<odoo>
    <record model="ir.ui.view" id="sale_order_form_cutting_info_view_inheited">
        <field name="name">sale.order.cost.form.inherited</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="name_description"/>
            </xpath>
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list/field[@name='name']" position="attributes">
               <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="cable_info" string="Cable Cutting Info">
                    <field name="cutting_info_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="no_of_piece"/>
                            <field name="no_of_meter"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="sale_order_tree_website_view_inheited">
        <field name="name">sale.order.website.tree.inherited</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="website_id" column_invisible="True"/>
            </field>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="decoration-success">state == 'sale'</attribute>
                <attribute name="decoration-warning">state == 'sent' and website_id</attribute>
                <attribute name="decoration-primary">state == 'sent' and not website_id</attribute>
            </xpath>
        </field>
    </record>
</odoo>
