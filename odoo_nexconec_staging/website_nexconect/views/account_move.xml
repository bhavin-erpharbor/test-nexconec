<odoo>
    <record id="view_move_form_inherit_nexconec" model="ir.ui.view">
        <field name="name">view.move.form.inherit.nexconec</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="delivery_message" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
