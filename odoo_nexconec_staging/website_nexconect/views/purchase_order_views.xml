<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_inherit_nexconect" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.nexconect</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- <xpath expr="//field[@name='date_approve']" position="attributes">
                <attribute name="widget">date</attribute>
            </xpath> -->
            <xpath expr="//field[@name='date_planned']" position="attributes">
                <attribute name="widget">date</attribute>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//sheet/group[1]/group[2]" position="inside">
                <field name="x_studio_expected_arrival" widget="datetime" readonly="0"/>
            </xpath>
            <field name='effective_date' position="after">
                <field name='x_studio_delivery_status' string='Delivery status'/>
            </field>
            <field name='origin' position="after">
                <field name="date_order" />
            </field>
        </field>
    </record>

     <record id="purchase_order_kpis_tree_inherit_nexconect" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.nexconect</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <field name="date_order" position="attributes">
                <attribute name="widget">date</attribute>
            </field>
        </field>
    </record>

</odoo>
