<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_purchaseorder_document_nexconect" priority="10000001" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <t t-set="address">
                    <t t-if="o.dest_address_id">
                        <strong t-if="o.dest_address_id">Delivery Adress :</strong>
                        <div t-field="o.dest_address_id"
                            t-options="{&quot;widget&quot;: &quot;contact&quot;,
                                        &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;],
                                        &quot;no_marker&quot;: True,
                                        &quot;phone_icons&quot;: True}"
                            name="purchase_shipping_address"/>
                        <p>Contact : <span t-field="o.x_studio_drop_ship_contact_1.name"/></p>
                    </t>
                    <t t-else="">
                        <strong t-if="o.picking_type_id.company_id.partner_id">Delivery Adress :</strong>
                        <div t-if="o.picking_type_id and o.picking_type_id.warehouse_id">
                            <span t-field="o.picking_type_id.warehouse_id.name"/>
                            <div t-field="o.picking_type_id.warehouse_id.partner_id" t-options='{"widget": "contact", "fields": ["address", "phone"], "no_marker": True, "phone_icons": True}'/>
                        </div>
                        <p>Contact : <span t-field="o.x_studio_drop_ship_contact_1.name"/></p>
                    </t>
                </t>
                <t t-set="information_block">
                    <strong>Vendor/Supplier:</strong>
                    <div t-if="o.partner_id">
                        <div t-field="o.partner_id"
                            t-options="{&quot;widget&quot;: &quot;contact&quot;,
                                        &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;],
                                        &quot;no_marker&quot;: True,
                                        &quot;phone_icons&quot;: True}"
                            name="purchase_partner_address"/>
                        <p t-if="o.partner_id.vat"><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>: <span t-field="o.partner_id.vat"/></p>
                    </div>
                </t>
                <div class="page">
                    <div class="oe_structure"/>

                    <div class="mt-4">
                    <h2 t-if="o.state == 'draft'" style="color:#026497;">Request For Quotation #<span t-field="o.name"/></h2>
                        <h2 t-if="o.state in ['sent', 'to approve']" style="color:#026497;">Purchase Order #<span t-field="o.name"/></h2>
                        <h2 t-if="o.state in ['purchase', 'done']" style="color:#026497;">Purchase Order #<span t-field="o.name"/></h2>
                        <h2 t-if="o.state == 'cancel'" style="color:#026497;">Bon de commande annulé #<span t-field="o.name"/></h2>
                    </div>

                    <div id="informations" class="row mt-4 mb32">
                        <div t-if="o.user_id" class="col-3 bm-2">
                            <strong style="color:#026497;">Purchase Representative:</strong>
                            <p t-field="o.user_id" class="m-0"/>
                        </div>
                        <div t-if="o.partner_ref" class="col-3 bm-2">
                            <strong style="color:#026497;">Your Order Reference:</strong>
                            <p t-field="o.partner_ref" class="m-0"/>
                        </div>
                        <div t-if="o.state in ['purchase','done'] and o.date_approve" class="col-3 bm-2">
                            <strong style="color:#026497;">Order Date:</strong>
                            <p t-field="o.date_approve" class="m-0"/>
                        </div>
                        <div t-elif="o.date_order" class="col-3 bm-2">
                            <strong style="color:#026497;">Order Deadline:</strong>
                            <p t-field="o.date_order" class="m-0"/>
                        </div>
                    </div>
                    <div id="informations" class="row mt32 mb32">
                        <div t-if="o.origin" class="col-3 bm-2">
                            <strong style="color:#026497;">Source Document:</strong>
                            <p t-field="o.origin" class="m-0"/>
                        </div>
                        <div t-if="o.payment_term_id" class="col-3 bm-2">
                            <strong style="color:#026497;">Payment Term:</strong>
                            <p t-field="o.payment_term_id" class="m-0"/>
                        </div>
                        <!-- <div t-if="o.x_studio_many2one_field_yWWBO" class="col-3 bm-2">
                            <strong style="color:#026497;">Delivery method:</strong>
                            <p t-field="o.x_studio_many2one_field_yWWBO" class="m-0"/>
                        </div> -->
                    </div>

                    <table class="table table-sm o_main_table mt-4 table-borderless">
                        <thead style="display: table-row-group;border-bottom: 1px solid lightgrey;border-top: 1px solid lightgrey; ">
                            <tr>
                                <th name="" class="text-left" style="color:#026497;"><strong>Line No</strong></th>
                                <th name="th_description" style="color:#026497;"><strong>Description</strong></th>
                                <!-- <th name="th_taxes" style="color:#026497;"><strong>Taxes</strong></th> -->
                                <!-- <th name="th_date_req" class="text-center" style="color:#026497;"><strong>Date Req.</strong></th> -->
                                <th name="th_prodcode" class="text-end" style="color:#026497;"><strong>Prod Code</strong></th>
                                <th name="th_quantity" class="text-end" style="color:#026497;"><strong>Qty</strong></th>
                                <th name="th_price_unit" class="text-end" style="color:#026497;"><strong>Unit Price</strong></th>
                                <th name="th_subtotal" class="text-end" style="color:#026497;">
                                    <strong>Amount</strong>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="current_subtotal" t-value="0"/>
                            <t t-set="counter" t-value="1"/>
                            <t t-foreach="o.order_line.filtered(lambda l: l.display_type or l.product_qty != 0)" t-as="line">
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>

                                <tr t-att-class="'fw-bolder o_line_section' if line.display_type == 'line_section' else 'fw-bold o_line_subsection' if line.display_type == 'line_subsection' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                    <t t-if="not line.display_type">
                                        <td>
                                            <span t-esc="counter" />
                                            <span t-set="counter" t-value="counter+1" />
                                        </td>
                                        <td id="product" class="text-start">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td class="text-end"></td>
                                        <td class="text-end">
                                            <span t-field="line.product_qty"/>
                                            <span t-field="line.product_uom_id.name" groups="uom.group_uom"/>
                                            <span t-if="line.product_uom_id != line.product_id.uom_id" class="text-muted small">
                                                <br/>
                                                <span t-field="line.product_uom_qty" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/> <span t-field="line.product_id.uom_id"/>
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_unit"/>
                                        </td>
<!--                                        <td class="text-end">-->
<!--                                            <span class="text-align-bottom"><span t-field="line.discount"/>%</span>-->
<!--                                        </td>-->
<!--                                        <td class="text-end">-->
<!--                                            <span t-out="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)"/>-->
<!--                                        </td>-->
                                        <td class="text-end">
                                            <span t-field="line.price_subtotal"
                                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </t>
                                    <t t-if="line.display_type in ('line_section', 'line_subsection')">
                                        <td colspan="99" id="section">
                                            <span t-field="line.name"/>
                                        </td>
                                        <t t-set="current_section" t-value="line"/>
                                        <t t-set="current_subtotal" t-value="0"/>
                                    </t>
                                    <t t-if="line.display_type == 'line_note'">
                                        <td colspan="99" id="note">
                                            <span t-field="line.name"/>
                                        </td>
                                    </t>
                                </tr>
                                <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type in ('line_section', 'line_subsection'))">
                                    <tr class="is-subtotal text-end">
                                        <td colspan="99" id="subtotal">
                                            <strong class="mr16">Subtotal</strong>
                                            <span
                                                t-out="current_subtotal"
                                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                            />
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <div id="total" class="row justify-content-end mt-n3">
                        <div class="col-4">
                            <table class="o_total_table table table-borderless">
                                <t t-call="purchase.document_tax_totals">
                                    <t t-set="tax_totals" t-value="o.tax_totals"/>
                                    <t t-set="currency" t-value="o.currency_id"/>
                                </t>
                            </table>
                        </div>
                    </div>

                    <p t-field="o.note" class="mt-4"/>
                    <div class="oe_structure"/>

                    <strong>Payment Terms: </strong>
                    <span t-field="o.payment_term_id" class="mt-4"></span>

                    <t t-set="base_address" t-value="o.env['ir.config_parameter'].sudo().get_param('web.base.url')"/>
                    <t t-set="portal_url" t-value="base_address + '/my/purchase/' + str(o.id) + '#portal_connect_software_modal'"/>
                    <div t-if="any(u._is_portal() for u in o.partner_id.user_ids) and o._get_edi_builders()" class="text-center">
                        <a t-att-href="portal_url">Connect your software</a> with <t t-out="o.company_id.name"/> to create quotes automatically.
                    </div>
                </div>
            </t>
        </xpath>
    </template>


   
</odoo>
