<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexconec_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">nexconec.sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="commitment_date" readonly="state == 'cancel' or locked"/>
            </xpath>
            <field name="commitment_date" position="attributes">
                <attribute name="string">ETA</attribute>
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </field>
        </field>
    </record>

</odoo>
