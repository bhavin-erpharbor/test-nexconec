<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexconec_base_res_config_setting_view_form" model="ir.ui.view">
        <field name="name">nexconec.base.res.config.setting.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="inside">
                <setting id="export_po_list" help="Automatically Send the PO list to vendor Nexconec.">
                    <field name="export_po_list_vendor_id"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
