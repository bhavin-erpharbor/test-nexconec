<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexconec_crm_lead_view_form" model="ir.ui.view">
        <field name="name">nexconec.crm.lead.view.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="weekly_leads"/>
            </field>
        </field>
    </record>

    <record id="nexconec_crm_lead_view_search" model="ir.ui.view">
        <field name="name">nexconec.crm.lead.view.search</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <filter name="source" position="after">
                <filter string="Weekly" name="group_by_lead_weekly" context="{'group_by':'weekly_leads'}"/>
            </filter>
        </field>
    </record>

</odoo>
