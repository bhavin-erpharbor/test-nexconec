<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nexconec_purchase_order_view_form_inherit" model="ir.ui.view">
        <field name="name">nexconec.purchase.order.view.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="multi_edit">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="nexconec_base_view_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">nexconec.base.purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </field>
        </field>
    </record>

</odoo>
