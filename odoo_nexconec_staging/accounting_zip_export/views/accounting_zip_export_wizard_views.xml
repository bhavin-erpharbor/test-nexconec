<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_accounting_zip_export_wizard_form" model="ir.ui.view">
        <field name="name">accounting.zip.export.wizard.form</field>
        <field name="model">accounting.zip.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Accounting ZIP">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="is_customer_invoice"/>
                            <field name="is_bill"/>
                            <field name="is_expense"/>
                        </group>
                        <group>
                            <field name="date_to"/>
                            <field name="exclude_partner_ids" widget="many2many_tags" invisible="not is_bill"/>
                        </group>
                    </group>

<!--                    <group invisible="not zip_file">-->
<!--                        <field name="zip_filename" readonly="1"/>-->
<!--                        <field name="zip_file" readonly="1" filename="zip_filename"/>-->
<!--                    </group>-->
                </sheet>

                <footer>
                    <button name="action_export_zip"
                            type="object"
                            string="Export ZIP"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_accounting_zip_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Accounting ZIP</field>
        <field name="res_model">accounting.zip.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_accounting_zip_export_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_accounting_zip_export"
              name="Export Accounting ZIP"
              parent="account.menu_finance_reports"
              action="action_accounting_zip_export_wizard"
              sequence="999"/>

</odoo>
