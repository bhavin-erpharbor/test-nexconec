<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="sale_order_sequence_form" model="ir.ui.view">
            <field name="name">sale.order.sequence.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="before">
                    <field name="sequence_no"/>
                </xpath>
                <xpath expr="//field[@name='order_line']/list//field[@name='product_template_id']" position="attributes">
                    <attribute name="options">{'no_create': True, 'no_edit': True}</attribute>
                    <attribute name="class">o_wrap_sale_line_text</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                    <attribute name="class">o_wrap_sale_line_text</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                     <attribute name="context">
                        {'default_type':'invoice','only_name': True, 'me_partner_delivery': partner_id, 'custom_invoice': True}
                    </attribute>
                </xpath>
                <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                     <attribute name="context">
                        {'default_type':'delivery', 'me_partner_delivery': partner_id, 'custom_delivery': True}
                    </attribute>
                </xpath>
                <field name="partner_id" position="after">
                    <field name="x_studio_partner_company" invisible="1"/>
                </field>
            </field>
        </record>

        <record id="sale_order_view_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="website_sale.sale_order_view_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="context">{
                    'display_website': True,
                    'only_company_name': True,
                    'res_partner_search_mode': 'customer',
                    'show_address': 1,
                    'show_vat': True,
                }</attribute>
                <attribute name="domain">
                        ['|', ('company_id', '=', False), ('company_id', '=', company_id)]
                    </attribute>
            </field>
        </field>
    </record>

    </data>
</odoo>
