<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron hebdo digest : chaque lundi à 07h00 -->
        <record id="ir_cron_sale_digest_weekly" model="ir.cron">
            <field name="name">Digest Commercial — Envoi hebdomadaire (lundi 7h)</field>
            <field name="model_id" ref="model_sale_digest"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_weekly_digest()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall" eval="(datetime.now() + relativedelta(weeks=1, weekday=0, hour=7, minute=0, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Cron mensuel : le 1er de chaque mois à 08h00 -->
        <record id="ir_cron_sale_digest_monthly" model="ir.cron">
            <field name="name">Digest Commercial — Rapport mensuel (1er du mois 8h)</field>
            <field name="model_id" ref="model_sale_digest"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_monthly_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(datetime.now() + relativedelta(months=1, day=1, hour=8, minute=0, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Cron rapport activités : chaque lundi à 07h30 -->
        <record id="ir_cron_activity_report_weekly" model="ir.cron">
            <field name="name">Rapports Activités — Envoi hebdomadaire (lundi 7h30)</field>
            <field name="model_id" ref="model_sale_activity_report"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_activity_reports()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall" eval="(datetime.now() + relativedelta(weeks=1, weekday=0, hour=7, minute=30, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
