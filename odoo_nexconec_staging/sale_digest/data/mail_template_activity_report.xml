<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="email_template_activity_report" model="mail.template">
      <field name="name">Rapport Activités Hebdomadaire (commercial ciblé)</field>
      <field name="model_id" ref="base.model_res_users"/>
      <field name="subject">📋 Activités de ${ctx.get('watched_user') and ctx['watched_user'].name or '?'} — ${ctx.get('week_label','')}</field>
      <field name="email_from">${object.company_id.email or user.email}</field>
      <field name="email_to">${object.email}</field>
      <field name="lang">fr_FR</field>
      <field name="auto_delete">False</field>
      <field name="body_html"><![CDATA[
<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"></head>
<body style="margin:0;padding:0;background:#F0F2F5;font-family:'Segoe UI',Arial,sans-serif;color:#1A1F2E;line-height:1.5;">

<table width="100%" cellpadding="0" cellspacing="0" style="background:#F0F2F5;padding:30px 10px;">
<tr><td align="center">
<table width="680" cellpadding="0" cellspacing="0" style="max-width:680px;background:#ffffff;border-radius:8px;overflow:hidden;">

  <!-- HEADER -->
  <tr>
    <td style="background:linear-gradient(135deg,#2D3748,#4A5568);padding:32px 40px;color:#fff;">
      <div style="font-size:12px;font-weight:600;opacity:0.7;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px;">Rapport d'activités hebdomadaire</div>
      <div style="font-size:24px;font-weight:800;">
        <t t-esc="(ctx or {}).get('watched_user') and (ctx or {}).get('watched_user').name or '—'"/>
      </div>
      <div style="font-size:14px;opacity:0.85;margin-top:6px;">
        <t t-esc="(ctx or {}).get('week_label','—')"/>
      </div>
      <div style="font-size:13px;opacity:0.65;margin-top:4px;">
        <t t-esc="(ctx or {}).get('company') and (ctx or {}).get('company').name or '—'"/>
      </div>
    </td>
  </tr>

  <!-- BANDEAU KPIs -->
  <tr>
    <td style="background:#F8FBFF;padding:20px 0;border-bottom:1px solid #E5EDF9;">
      <table width="100%">
        <tr>
          <td width="20%" align="center" style="border-right:1px solid #DDE6F5;padding:0 8px;">
            <div style="font-size:28px;font-weight:800;color:#4A5568;line-height:1;"><t t-esc="(ctx or {}).get('nb_calls', 0)"/></div>
            <div style="font-size:10px;font-weight:600;color:#7B8AAA;text-transform:uppercase;margin-top:4px;">Appels</div>
          </td>
          <td width="20%" align="center" style="border-right:1px solid #DDE6F5;padding:0 8px;">
            <div style="font-size:28px;font-weight:800;color:#4A5568;line-height:1;"><t t-esc="(ctx or {}).get('nb_emails', 0)"/></div>
            <div style="font-size:10px;font-weight:600;color:#7B8AAA;text-transform:uppercase;margin-top:4px;">Emails</div>
          </td>
          <td width="20%" align="center" style="border-right:1px solid #DDE6F5;padding:0 8px;">
            <div style="font-size:28px;font-weight:800;color:#2E7DF7;line-height:1;"><t t-esc="(ctx or {}).get('nb_meetings', 0)"/></div>
            <div style="font-size:10px;font-weight:600;color:#7B8AAA;text-transform:uppercase;margin-top:4px;">RDV</div>
          </td>
          <td width="20%" align="center" style="border-right:1px solid #DDE6F5;padding:0 8px;">
            <div style="font-size:28px;font-weight:800;color:#F9A825;line-height:1;"><t t-esc="(ctx or {}).get('nb_quotes', 0)"/></div>
            <div style="font-size:10px;font-weight:600;color:#7B8AAA;text-transform:uppercase;margin-top:4px;">Devis</div>
          </td>
          <td width="20%" align="center" style="padding:0 8px;">
            <div style="font-size:28px;font-weight:800;color:#1DB868;line-height:1;"><t t-esc="(ctx or {}).get('nb_orders', 0)"/></div>
            <div style="font-size:10px;font-weight:600;color:#7B8AAA;text-transform:uppercase;margin-top:4px;">Commandes</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <tr><td style="padding:32px 40px 0;">

    <!-- ACTIVITÉS -->
    <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#9AA3B5;margin-bottom:12px;">📞 Activités réalisées</div>
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:8px;">
      <tr style="background:#F8FBFF;">
        <th style="text-align:left;padding:8px 10px;font-size:11px;color:#9AA3B5;">Type</th>
        <th style="text-align:left;padding:8px 10px;font-size:11px;color:#9AA3B5;">Titre</th>
        <th style="text-align:left;padding:8px 10px;font-size:11px;color:#9AA3B5;">Client / Affaire</th>
        <th style="text-align:left;padding:8px 10px;font-size:11px;color:#9AA3B5;">Échéance</th>
      </tr>
      <t t-foreach="(ctx or {}).get('activities_list', [])" t-as="act">
      <tr>
        <td style="padding:9px 10px;border-bottom:1px solid #F0F3FA;">
          <span style="display:inline-block;padding:2px 8px;border-radius:999px;font-size:10px;font-weight:600;background:#EAF1FF;color:#1B4F99;">
            <t t-esc="act.activity_type_id.name"/>
          </span>
        </td>
        <td style="padding:9px 10px;border-bottom:1px solid #F0F3FA;font-size:13px;">
          <t t-esc="act.summary or act.activity_type_id.name"/>
        </td>
        <td style="padding:9px 10px;border-bottom:1px solid #F0F3FA;font-size:13px;color:#4A5568;">
          <t t-esc="act.res_name or '—'"/>
        </td>
        <td style="padding:9px 10px;border-bottom:1px solid #F0F3FA;font-size:13px;">
          <t t-esc="act.date_deadline.strftime('%d/%m/%Y') if act.date_deadline else '—'"/>
        </td>
      </tr>
      </t>
      <t t-if="not (ctx or {}).get('activities_list')">
      <tr><td colspan="4" style="text-align:center;padding:20px;color:#9AA3B5;font-size:13px;">Aucune activité sur la période.</td></tr>
      </t>
    </table>
    <t t-if="(ctx or {}).get('nb_overdue', 0) &gt; 0">
    <div style="background:#FDECEA;border-radius:6px;padding:10px 14px;font-size:13px;color:#C0392B;font-weight:600;margin-bottom:28px;">
      ⚠️ <t t-esc="(ctx or {}).get('nb_overdue', 0)"/> activité(s) en retard non traitée(s)
    </div>
    </t>

    <!-- RDV -->
    <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#9AA3B5;margin-bottom:12px;margin-top:28px;">🤝 Rendez-vous clients</div>
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:28px;">
      <tr style="background:#F8FBFF;">
        <th style="text-align:left;padding:8px 10px;font-size:11px;color:#9AA3B5;">Intitulé</th>
        <th style="text-align:left;padding:8px 10px;font-size:11px;color:#9AA3B5;">Date</th>
        <th style="text-align:left;padding:8px 10px;font-size:11px;color:#9AA3B5;">Participants</th>
      </tr>
      <t t-foreach="(ctx or {}).get('meetings_list', [])" t-as="meet">
      <tr>
        <td style="padding:9px 10px;border-bottom:1px solid #F0F3FA;font-size:13px;font-weight:600;">
          <t t-esc="meet.name"/>
        </td>
        <td style="padding:9px 10px;border-bottom:1px solid #F0F3FA;font-size:13px;">
          <t t-esc="meet.start.strftime('%d/%m/%Y %H:%M') if meet.start else '—'"/>
        </td>
        <td style="padding:9px 10px;border-bottom:1px solid #F0F3FA;font-size:13px;color:#4A5568;">
          <t t-esc="', '.join(meet.partner_ids.mapped('name')[:3]) if meet.partner_ids else '—'"/>
        </td>
      </tr>
      </t>
      <t t-if="not (ctx or {}).get('meetings_list')">
      <tr><td colspan="3" style="text-align:center;padding:20px;color:#9AA3B5;font-size:13px;">Aucun RDV sur la période.</td></tr>
      </t>
    </table>

    <!-- DEVIS -->
    <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#9AA3B5;margin-bottom:12px;">📄 Devis émis</div>
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:8px;">
      <tr style="background:#F8FBFF;">
        <th style="text-align:left;padding:8px 10px;font-size:11px;color:#9AA3B5;">Réf.</th>
        <th style="text-align:left;padding:8px 10px;font-size:11px;color:#9AA3B5;">Client</th>
        <th style="text-align:right;padding:8px 10px;font-size:11px;color:#9AA3B5;">Montant HT</th>
        <th style="text-align:left;padding:8px 10px;font-size:11px;color:#9AA3B5;">État</th>
      </tr>
      <t t-foreach="(ctx or {}).get('quotes_list', [])" t-as="q">
      <tr>
        <td style="padding:9px 10px;border-bottom:1px solid #F0F3FA;font-size:13px;font-weight:600;color:#2E7DF7;"><t t-esc="q.name"/></td>
        <td style="padding:9px 10px;border-bottom:1px solid #F0F3FA;font-size:13px;"><t t-esc="q.partner_id.name or '—'"/></td>
        <td style="padding:9px 10px;border-bottom:1px solid #F0F3FA;font-size:13px;text-align:right;font-weight:700;">
          <t t-esc="'{:,.0f} €'.format(q.amount_untaxed).replace(',', ' ')"/>
        </td>
        <td style="padding:9px 10px;border-bottom:1px solid #F0F3FA;">
          <span t-attf-style="display:inline-block;padding:2px 8px;border-radius:999px;font-size:10px;font-weight:600;background:{{ '#FFF6E5;color:#B36B00' if q.state == 'draft' else '#EAF1FF;color:#1B4F99' }};">
            <t t-esc="'Brouillon' if q.state == 'draft' else 'Envoyé'"/>
          </span>
        </td>
      </tr>
      </t>
      <t t-if="not (ctx or {}).get('quotes_list')">
      <tr><td colspan="4" style="text-align:center;padding:20px;color:#9AA3B5;font-size:13px;">Aucun devis émis sur la période.</td></tr>
      </t>
    </table>
    <t t-if="(ctx or {}).get('nb_quotes', 0) &gt; 0">
    <div style="text-align:right;font-size:13px;font-weight:700;color:#4A5568;padding:6px 0 20px;">
      Total devis : <t t-esc="(ctx or {}).get('quotes_amount','0 €')"/>
    </div>
    </t>

    <!-- COMMANDES -->
    <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#9AA3B5;margin-bottom:12px;margin-top:8px;">✅ Commandes confirmées</div>
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:8px;">
      <tr style="background:#F8FBFF;">
        <th style="text-align:left;padding:8px 10px;font-size:11px;color:#9AA3B5;">Réf.</th>
        <th style="text-align:left;padding:8px 10px;font-size:11px;color:#9AA3B5;">Client</th>
        <th style="text-align:right;padding:8px 10px;font-size:11px;color:#9AA3B5;">Montant HT</th>
        <th style="text-align:left;padding:8px 10px;font-size:11px;color:#9AA3B5;">Date</th>
      </tr>
      <t t-foreach="(ctx or {}).get('orders_list', [])" t-as="o">
      <tr>
        <td style="padding:9px 10px;border-bottom:1px solid #F0F3FA;font-size:13px;font-weight:600;color:#1DB868;"><t t-esc="o.name"/></td>
        <td style="padding:9px 10px;border-bottom:1px solid #F0F3FA;font-size:13px;"><t t-esc="o.partner_id.name or '—'"/></td>
        <td style="padding:9px 10px;border-bottom:1px solid #F0F3FA;font-size:13px;text-align:right;font-weight:700;">
          <t t-esc="'{:,.0f} €'.format(o.amount_untaxed).replace(',', ' ')"/>
        </td>
        <td style="padding:9px 10px;border-bottom:1px solid #F0F3FA;font-size:13px;">
          <t t-esc="o.date_order.strftime('%d/%m/%Y') if o.date_order else '—'"/>
        </td>
      </tr>
      </t>
      <t t-if="not (ctx or {}).get('orders_list')">
      <tr><td colspan="4" style="text-align:center;padding:20px;color:#9AA3B5;font-size:13px;">Aucune commande confirmée sur la période.</td></tr>
      </t>
    </table>
    <t t-if="(ctx or {}).get('nb_orders', 0) &gt; 0">
    <div style="text-align:right;font-size:13px;font-weight:700;color:#1DB868;padding:6px 0 0;">
      Total confirmé : <t t-esc="(ctx or {}).get('orders_amount','0 €')"/>
    </div>
    </t>

  </td></tr>

  <!-- CTA -->
  <tr>
    <td style="padding:32px 40px;text-align:center;">
      <a t-att-href="(ctx or {}).get('base_url','') + '/odoo/crm'" style="background:#4A5568;color:#ffffff;text-decoration:none;padding:12px 32px;border-radius:6px;font-weight:700;font-size:14px;display:inline-block;">
        Voir le CRM →
      </a>
    </td>
  </tr>

  <!-- FOOTER -->
  <tr>
    <td style="background:#F8FBFF;padding:20px 40px;text-align:center;font-size:12px;color:#9AA3B5;border-top:1px solid #E5EDF9;">
      <t t-esc="(ctx or {}).get('company') and (ctx or {}).get('company').name or '—'"/> · Rapport d'activités hebdomadaire<br/>
      Période : <t t-esc="(ctx or {}).get('date_start')"/> → <t t-esc="(ctx or {}).get('date_end')"/>
    </td>
  </tr>

</table>
</td></tr>
</table>
</body>
</html>
      ]]></field>
    </record>
  </data>
</odoo>
