<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_ehcs_france_product_db_sync" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ehcs.france.product.db.sync</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="France → Hong Kong Product Sync" name="ehcs_france_product_db_sync" logo="/ehcs_product_sync/static/description/logo.png">
                    <block title="France → Hong Kong Product Sync">
                        <setting string="Enable Sync">
                            <field name="ehcs_product_sync_enabled"/>
                        </setting>
                        <setting string="Remote URL">
                            <field name="ehcs_remote_odoo_url" placeholder="France Server URL"/>
                        </setting>
                        <setting string="Remote Database">
                            <field name="ehcs_remote_odoo_db" placeholder="France Server Database"/>
                        </setting>
                        <setting string="Remote Username">
                            <field name="ehcs_remote_odoo_username" placeholder="France Server Username"/>
                        </setting>
                        <setting string="Remote Password">
                            <field name="ehcs_remote_odoo_password" password="True" placeholder="France Server Password"/>
                        </setting>
                        <setting string="Actions">
                            <button name="action_ehcs_test_remote_connection" type="object" string="Test Connection" class="btn-secondary"/><br/><br/>
                            <button name="action_ehcs_sync_product_attributes_now" type="object" string="Sync Product Attributes Now" class="btn-primary"/>
                            <button name="action_ehcs_sync_products_now" type="object" string="Sync Products Now" class="btn-primary ms-2"/>

                            <div class="mt-3">
                                <label for="ehcs_product_sync_limit">Variant Sync Limit: </label>
                                <field name="ehcs_product_sync_limit" style="margin-left:10px;"/>
                            </div>

                            <div class="mt-3">
                                <label for="ehcs_variant_sync_progress">Variant Sync Progress: </label>
                                <field name="ehcs_variant_sync_progress" readonly="1" style="margin-left:10px;"/>
                            </div>

                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
