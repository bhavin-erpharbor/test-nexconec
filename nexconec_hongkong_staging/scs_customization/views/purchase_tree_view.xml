<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_kpis_tree_inherited" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherited</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="actual_shipment_date"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_order_tree_inherited" model="ir.ui.view">
        <field name="name">purchase.order.tree.view.inherited</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="actual_shipment_date"/>
            </xpath>
        </field>
    </record>

    <record id="product_variant_form_view_inherited" model="ir.ui.view">
        <field name="name">product.product.form.view.inherited</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="hs_codes" string="Hs Code">
                    <field name="hs_code_line_ids">
                        <list editable="bottom">
                            <field name="partner_id"/>
                            <field name="hs_code"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_view_inherited" model="ir.ui.view">
        <field name="name">purchase.order.form.view.inherited</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="actual_shipment_date"/>
            </xpath>
            <xpath expr="//page[@name='products']/field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="name_description"/>
            </xpath>
            <xpath expr="//page[@name='products']/field[@name='order_line']/list/field[@name='name']" position="attributes">
               <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <record id="purchase.action_purchase_history" model="ir.actions.act_window">
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="purchase.purchase_history_tree"/>
        <field name="context">{
                'search_default_order_date_last_year': 1,
                'search_default_groupby_product': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No purchase order were made for this product yet!
            </p>
        </field>
    </record>

    <record id="res_partner_form_view_inherited" model="ir.ui.view">
        <field name="name">res.partner.form.view.inherited</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_product_pricelist']" position="after">
              <field name="x_studio_credit_limit" string="Credit Limit"/>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Visit Reports">
                    <field name="visit_entry_ids" invisible="company_type != 'company'" context="{'form_view_ref': 'scs_customization.visit_entry_form_view'}">
                        <list>
                            <field name="date"/>
                            <field name="opportunities"/>
                            <field name="challenges"/>
                            <field name="actions"/>
                        </list>
                    </field>
                    <field name="contact_visit_entry_ids" invisible="company_type != 'person'" context="{'form_view_ref': 'scs_customization.visit_entry_form_view'}">
                        <list>
                            <field name="date"/>
                            <field name="opportunities"/>
                            <field name="challenges"/>
                            <field name="actions"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_only_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="hs_codes" string="Hs Code">
                    <field name="hs_code_line_ids">
                        <list editable="bottom">
                            <field name="partner_id"/>
                            <field name="hs_code"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="x_studio_datasheet_link_1" string="Datasheet Link" widget="url"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="nex_hong_sale_order_form_view_inherited">
        <field name="name">sale.order.hong.form.inherited</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="name_description"/>
            </xpath>
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list/field[@name='name']" position="attributes">
               <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>
</odoo>

