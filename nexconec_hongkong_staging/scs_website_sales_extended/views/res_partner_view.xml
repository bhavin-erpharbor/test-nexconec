<odoo>

    <record id="view_partner_form_view_inherit_nexconect" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook//page[last()]" position="after">
                <page string="Categories">
                    <field name="public_categ_ids"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_view_form_readonly_inherit" model="ir.ui.view">
        <field name="name">sale.order.line.form.readonly.inherit</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.sale_order_line_view_form_readonly"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_id']" position="before">
                <field name="custom_val"/>
            </xpath>
        </field>
    </record>

</odoo>
